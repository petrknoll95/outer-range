---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { media } from '../assets/media';
import { VARIANT_SHORT_EDGES } from '../canvas/config';
import { resolveImages } from '../canvas/images';
import type { ClientProject } from '../canvas/projects';
import { resolveProjects } from '../canvas/projects';
import type { CanvasData, ClientImage } from '../canvas/renderer';
import { compiledContent, frontmatter as about } from '../content/about.md';
import Header from './Header.astro';

/**
 * The site: the canvas of images under the header. Both pages render it, `/` and `/about`, as
 * two views of one document: going between them is a flight of the canvas (main.ts), not a
 * page load, so the view is kept exactly and the history buttons run the same transition.
 * `route` is the view the page opens on.
 */
interface Props {
  route: 'home' | 'about';
}

const { route } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>(['../assets/placeholders/*.jpg', '../assets/work/*.webp', '../assets/videos/*.jpg'], {
  eager: true,
});
const videos = import.meta.glob<string>('../assets/videos/*.mp4', { eager: true, query: '?url', import: 'default' });
// Photos hide compression well; designed work (fine type, flat colour) shows it, so it gets more.
const QUALITY = { photo: { avif: 55, webp: 76 }, detail: { avif: 75, webp: 90 } } as const;

/** One srcset per format, with a variant at each short edge the master can supply. */
async function srcset(src: ImageMetadata, format: 'avif' | 'webp', widths: number[], detail: boolean): Promise<string> {
  const quality = QUALITY[detail ? 'detail' : 'photo'][format];
  const urls = await Promise.all(widths.map((width) => getImage({ src, width, format, quality })));
  return urls.map((img, n) => `${img.src} ${widths[n]}w`).join(', ');
}

// Each image's (or video's) content entry, in media order. Fails the build if one has none or two.
const content = resolveImages(
  (await getCollection('images')).map((entry) => ({ id: entry.id, ...entry.data })),
  media.map((m) => m.file),
);

const images: ClientImage[] = await Promise.all(
  media.map(async (m, n) => {
    // A video's tile is built like an image's from its poster frame, and plays the video over it.
    const src = files[`../assets/${m.still}`]!.default;
    const short = Math.min(m.width, m.height);
    // Every standard size the master can supply, topped with the master itself (or the largest standard size, if it is bigger).
    const top = Math.min(short, VARIANT_SHORT_EDGES.at(-1)!);
    const edges = [...VARIANT_SHORT_EDGES.filter((e) => e < top * 0.9), top];
    const widths = edges.map((e) => Math.round((m.width * e) / short));
    const detail = m.detail ?? false;
    const [avif, webp] = await Promise.all([srcset(src, 'avif', widths, detail), srcset(src, 'webp', widths, detail)]);
    const { title, category, alt } = content[n]!;
    const video = m.video ? videos[`../assets/${m.video}`]! : undefined;
    return { aspect: m.aspect, color: m.color, avif, webp, src: webp.split(' ')[0]!, video, title, category, alt };
  }),
);

// Zooming in stops where images would go soft; use the short edge three quarters of them reach.
const shortEdges = media.map((m) => Math.min(m.width, m.height)).sort((a, b) => a - b);
const sharpEdge = shortEdges[Math.floor(shortEdges.length * 0.25)]!;

// Projects associate images. Fails the build if any image is in no project or two.
const projects: ClientProject[] = resolveProjects(
  (await getCollection('projects')).map((entry) => ({ id: entry.id, ...entry.data })),
  content.map((entry) => entry.id),
);

// Inline JSON; escape '<' so no string can close the script element.
const data = JSON.stringify({ sharpEdge, images, projects } satisfies CanvasData & { projects: ClientProject[] }).replace(
  /</g,
  '\\u003c',
);

// The about text, split where it places the services list (`<!-- services -->` in about.md).
const [aboutBefore, aboutAfter = ''] = (await compiledContent()).split('<!-- services -->');
---

<Header route={route} />
<main
  data-canvas
  inert={route === 'about'}
  aria-label="Image canvas. Drag, scroll or use the arrow keys to move around; pinch, ctrl-scroll or plus and minus to zoom."
  class="fixed inset-0 z-[1] cursor-grab touch-none overflow-hidden select-none data-dragging:cursor-grabbing"
>
  <div data-canvas-layer class="absolute inset-0"></div>
</main>
<!--
  The about view: a narrow column centred in the window, scrolling on its own when it runs
  longer (src/content/about.md). It is a layer behind the canvas: flying to it, the camera
  passes through the images and it comes towards the camera from far off (main.ts). Whichever
  of the two isn't showing is inert and lets every click and scroll through.
-->
<div
  data-about
  data-state={route === 'about' ? 'in' : undefined}
  inert={route !== 'about'}
  class="about-view fixed inset-0 z-0 overflow-y-auto overscroll-contain"
>
  <div data-about-layer class="about-layer flex min-h-full items-center justify-center px-6 pt-40 pb-24">
    <article class="about w-full max-w-[34rem]">
      <Fragment set:html={aboutBefore} />
      <section class="services" aria-label="Services">
        <div class="services-groups">
          {
            (about.services as { group: string; items: string[] }[]).map(({ group, items }) => (
              <div>
                <h3>{group}</h3>
                <ul>
                  {items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>
      <Fragment set:html={aboutAfter} />
      <section class="list" aria-labelledby="awards">
        <h2 id="awards">Awards</h2>
        <ul>
          {(about.awards as string[]).map((award) => (
            <li>{award}</li>
          ))}
        </ul>
      </section>
      <section class="list" aria-labelledby="social">
        <h2 id="social">Social</h2>
        <ul>
          {(about.social as { name: string; url: string }[]).map(({ name, url }) => (
            <li>
              <a href={url} target="_blank" rel="me noopener">
                {name}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </div>
</div>
<script is:inline type="application/json" id="canvas-data" set:html={data} />
<script>
  import '../canvas/main';
</script>
