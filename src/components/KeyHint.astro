---
/**
 * A key hint for a view (hint.ts): its key, then what it does, as a link or a list item. While its
 * view is open (the about view, the menu, Start a project…) it takes `data-active`: the label
 * slides through its mask to `activeLabel` (Back, Close: src/canvas/hints.ts, setHint), and then an
 * ESC is added to the right of the key, the key moving left to make room, as either key now leaves
 * the view. The label never moves for it: the ESC comes in over where the key was. That is for a
 * hint at the window's right edge (`edge`, the default); one at its left edge would be pushed out
 * past it, so there the key stays, the ESC comes in just to its right, and the label moves right
 * to make room. Only opacity and transforms change, so the hint's box doesn't grow for it: a hint
 * after a left-edge one has to move over by as much itself (InfoBar.astro, I after P).
 */
import type { HTMLAttributes } from 'astro/types';
import { ESC_GAP, ESC_MOVE, ESC_WIDTH, glyph, GPU, label, pill } from './hint';

interface Props extends HTMLAttributes<'a'> {
  /** Which view's (setHint finds it by this). */
  name: string;
  /** Its key: a letter. */
  letter: string;
  label: string;
  activeLabel: string;
  active?: boolean;
  as?: 'a' | 'li' | 'button';
  /** Only where there are keys to press (a fine pointer); without them it is the label alone. */
  keysOnlyWithKeyboard?: boolean;
  /** Extra attributes for the label. */
  labelAttributes?: Record<string, string>;
  /** Which edge of the window it sits at: what makes room for the ESC is whatever is away from that edge. */
  edge?: 'left' | 'right';
}

const { name, letter, label: text, activeLabel, active = false, as = 'li', keysOnlyWithKeyboard = false, labelAttributes = {}, edge = 'right', class: className, ...rest } = Astro.props;
// Typed as a link or list item: their attributes pass through as they are, a button's `type` included.
const Tag = as as 'a' | 'li';
// After the label has changed, the ESC comes in and the key makes room; leaving, both go at once.
const move = `transition-[translate,opacity,scale] ${ESC_MOVE} ${GPU} group-data-active/hint:delay-150`;
/** The key's width (w-6), design px. */
const KEY_WIDTH = 24;
const left = edge === 'left';
---

<Tag
  data-hint={name}
  data-label={text}
  data-active-label={activeLabel}
  data-active={active ? '' : undefined}
  class:list={['group/hint flex items-center gap-[9.6px]', className]}
  {...rest}
>
  <span class:list={['relative', GPU, keysOnlyWithKeyboard ? 'hidden [@media(hover:hover)_and_(pointer:fine)]:flex' : 'flex']}>
    <span aria-hidden="true" data-hint-key class:list={[pill, 'w-6', move, !left && 'group-data-active/hint:-translate-x-(--hint-shift)']} style={`--hint-shift: ${ESC_WIDTH + ESC_GAP}px`}>
      <span class={glyph}>{letter}</span>
    </span>
    <span
      aria-hidden="true"
      data-hint-esc
      class:list={[
        pill,
        // At the right edge, in over where the key was; at the left, out from under the key to just right of it.
        left ? 'absolute left-0 group-data-active/hint:translate-x-(--esc-shift)' : 'absolute right-0',
        move,
        'scale-75 opacity-0 group-data-active/hint:scale-100 group-data-active/hint:opacity-100',
      ]}
      style={`width: ${ESC_WIDTH}px; --esc-shift: ${KEY_WIDTH + ESC_GAP}px`}
    >
      <span class={glyph}>ESC</span>
    </span>
  </span>
  <!-- A mask with a little room above and below the letters, for the label to slide through. -->
  <span class:list={['-my-[0.15em] overflow-hidden py-[0.15em]', GPU, left && [move, 'group-data-active/hint:translate-x-(--hint-shift)']]} style={left ? `--hint-shift: ${ESC_WIDTH + ESC_GAP}px` : undefined}>
    <span data-hint-label class:list={[label, 'block', GPU]} {...labelAttributes}>{active ? activeLabel : text}</span>
  </span>
</Tag>
