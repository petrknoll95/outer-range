---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import manifest from '../assets/placeholders/manifest.json';
import { VARIANT_SHORT_EDGES } from '../canvas/config';
import { resolveImages } from '../canvas/images';
import type { ClientProject } from '../canvas/projects';
import { resolveProjects } from '../canvas/projects';
import type { CanvasData, ClientImage } from '../canvas/renderer';
import type { Aspect } from '../canvas/world';
import Layout from '../layouts/Layout.astro';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/placeholders/*.jpg', { eager: true });
const QUALITY = { avif: 55, webp: 76 } as const;

/** One srcset per format, with a variant at each short edge the master can supply. */
async function srcset(src: ImageMetadata, format: 'avif' | 'webp', widths: number[]): Promise<string> {
  const urls = await Promise.all(widths.map((width) => getImage({ src, width, format, quality: QUALITY[format] })));
  return urls.map((img, n) => `${img.src} ${widths[n]}w`).join(', ');
}

// Each image's content entry, in manifest order. Fails the build if an image has none or two.
const content = resolveImages(
  (await getCollection('images')).map((entry) => ({ id: entry.id, ...entry.data })),
  manifest.map((m) => m.file),
);

const images: ClientImage[] = await Promise.all(
  manifest.map(async (m, n) => {
    const src = files[`../assets/placeholders/${m.file}`]!.default;
    const short = Math.min(m.width, m.height);
    // Every standard size the master can supply, topped with the master itself.
    const edges = [...VARIANT_SHORT_EDGES.filter((e) => e < short * 0.9), short];
    const widths = edges.map((e) => Math.round((m.width * e) / short));
    const [avif, webp] = await Promise.all([srcset(src, 'avif', widths), srcset(src, 'webp', widths)]);
    const { title, category, alt } = content[n]!;
    return { aspect: m.aspect as Aspect, color: m.color, avif, webp, src: webp.split(' ')[0]!, title, category, alt };
  }),
);

// Zooming in stops where images would go soft; use the short edge three quarters of them reach.
const shortEdges = manifest.map((m) => Math.min(m.width, m.height)).sort((a, b) => a - b);
const sharpEdge = shortEdges[Math.floor(shortEdges.length * 0.25)]!;

// Projects associate images. Fails the build if any image is in no project or two.
const projects: ClientProject[] = resolveProjects(
  (await getCollection('projects')).map((entry) => ({ id: entry.id, ...entry.data })),
  content.map((entry) => entry.id),
);

// Inline JSON; escape '<' so no string can close the script element.
const data = JSON.stringify({ sharpEdge, images, projects } satisfies CanvasData & { projects: ClientProject[] }).replace(
  /</g,
  '\\u003c',
);
---

<Layout title="Petr Knoll" description="An infinite canvas of images.">
  <!--
    Pages the canvas flies out to (data-fly-out, see main.ts) are prerendered on hover or press,
    so the page changes the moment the flight has cleared the screen.
  -->
  <script
    is:inline
    slot="head"
    type="speculationrules"
    set:html={JSON.stringify({ prerender: [{ where: { selector_matches: 'a[data-fly-out]' }, eagerness: 'moderate' }] })}
  />
  <!--
    The wordmark at the top centre and the About link at the top right, set alike. White with a
    difference blend, so they read on the light or dark canvas and over any image passing under
    them. Only the link takes pointer events: dragging or scrolling across the rest moves the canvas.
  -->
  <header data-chrome class="pointer-events-none fixed inset-x-0 top-4 z-20 flex h-9 items-center justify-center mix-blend-difference select-none">
    <h1 class="text-2xl leading-none font-medium tracking-[-0.02em] text-white">Petr Knoll</h1>
    <nav class="absolute inset-y-0 right-6 flex items-center">
      <a
        href="/about"
        data-fly-out
        class="pointer-events-auto rounded-sm text-2xl leading-none font-medium tracking-[-0.02em] text-white transition-opacity hover:opacity-60 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
        >About</a
      >
    </nav>
  </header>
  <main
    data-canvas
    aria-label="Image canvas. Drag, scroll or use the arrow keys to move around; pinch, ctrl-scroll or plus and minus to zoom."
    class="fixed inset-0 cursor-grab touch-none overflow-hidden select-none data-dragging:cursor-grabbing"
  >
    <div data-canvas-layer class="absolute inset-0"></div>
  </main>
  <script is:inline type="application/json" id="canvas-data" set:html={data} />
  <script>
    import '../canvas/main';
  </script>
</Layout>
